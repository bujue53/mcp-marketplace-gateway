// OpenAPI 自动生成的独立 MCP Server。Node.js 22+；npm install && npm run build && npm start。
import { createServer, type IncomingMessage, type ServerResponse } from 'node:http';

interface Tool {
  name: string;
  description?: string;
  inputSchema: { required?: string[]; [key: string]: unknown };
}
interface Parameter { name: string; in: string; argument: string[]; required: boolean; style: string; explode: boolean }
interface Security { key: string; type: string; in: string; name: string; scheme: string }
interface Binding { tool: Tool; method: string; path: string; baseURL: string; parameters: Parameter[]; security: Security[][]; body: boolean; bodyRequired: boolean; contentType: string }
interface Metadata { name: string; version: string; baseURL: string; overrideBaseURL: string; bindings: Binding[] }
const metadata = JSON.parse(__METADATA__) as Metadata;
const protocolVersion = '2025-03-26';
const tools = new Map(metadata.bindings.map(binding => [binding.tool.name, binding]));
const baseURL = (process.env.REST_BASE_URL || metadata.baseURL).replace(/\/+$/, '');
const overrideBaseURL = process.env.REST_BASE_URL || metadata.overrideBaseURL;
const base = new URL(baseURL);
if (!['http:', 'https:'].includes(base.protocol) || base.search || base.hash) {
  throw new Error('REST_BASE_URL must be an absolute HTTP(S) URL without query or fragment');
}

function object(value: unknown): value is Record<string, unknown> {
  return value !== null && typeof value === 'object' && !Array.isArray(value);
}
function json(response: ServerResponse, status: number, value: unknown): void {
  response.writeHead(status, { 'Content-Type': 'application/json; charset=utf-8' });
  response.end(JSON.stringify(value));
}
function rpcError(response: ServerResponse, status: number, id: unknown, code: number, message: string): void {
  json(response, status, { jsonrpc: '2.0', id: id ?? null, error: { code, message } });
}
async function readJSON(request: IncomingMessage): Promise<unknown> {
  const chunks: Buffer[] = [];
  let size = 0;
  for await (const chunk of request) {
    const bytes = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);
    size += bytes.length;
    if (size > 1024 * 1024) throw new Error('request exceeds 1 MiB');
    chunks.push(bytes);
  }
  return JSON.parse(Buffer.concat(chunks).toString('utf8')) as unknown;
}
function scalar(value: unknown): string {
  if (!['string', 'number', 'boolean'].includes(typeof value)) {
    throw new Error('parameter value must be a string, number or boolean');
  }
  return String(value);
}
function simple(value: unknown, explode: boolean, escape = false): string {
  const encode = (item: unknown) => escape ? encodeURIComponent(scalar(item)) : scalar(item);
  if (Array.isArray(value)) return value.map(encode).join(',');
  if (object(value)) return Object.keys(value).sort().flatMap(key => {
    const name = escape ? encodeURIComponent(key) : key;
    return explode ? [name + '=' + encode(value[key])] : [name, encode(value[key])];
  }).join(',');
  return encode(value);
}
function lookup(args: Record<string, unknown>, keys: string[]): unknown {
  let value: unknown = args;
  for (const key of keys) { if (!object(value)) return undefined; value = value[key]; }
  return value;
}
function addParameter(values: URLSearchParams, parameter: Parameter, value: unknown): void {
  const { name, style, explode } = parameter;
  if (style === 'deepObject') {
    if (!object(value)) throw new Error(name + ' must be an object');
    for (const key of Object.keys(value).sort()) values.append(name + '[' + key + ']', scalar(value[key]));
  } else if (style === 'spaceDelimited' || style === 'pipeDelimited') {
    if (!Array.isArray(value)) throw new Error(name + ' must be an array');
    values.append(name, value.map(scalar).join(style === 'spaceDelimited' ? ' ' : '|'));
  } else if (explode && Array.isArray(value)) {
    for (const item of value) values.append(name, scalar(item));
  } else if (explode && object(value)) {
    for (const key of Object.keys(value).sort()) values.append(key, scalar(value[key]));
  } else values.append(name, simple(value, false));
}
function security(binding: Binding, args: Record<string, unknown>, headers: Record<string, string>, query: URLSearchParams, cookies: URLSearchParams): void {
  if (!binding.security?.length) return;
  const auth = object(args.auth) ? args.auth : {};
  for (const alternative of binding.security) {
    const credentials = alternative.map(scheme => {
      const provided = auth[scheme.key];
      return typeof provided === 'string' && provided ? provided :
        scheme.type === 'http' && scheme.scheme === 'bearer' ? process.env.REST_BEARER_TOKEN || '' : '';
    });
    if (credentials.some(value => !value)) continue;
    alternative.forEach((scheme, index) => {
      if (scheme.type === 'http') headers.authorization = 'Bearer ' + credentials[index];
      else if (scheme.in === 'header') headers[scheme.name.toLowerCase()] = credentials[index];
      else if (scheme.in === 'query') query.set(scheme.name, credentials[index]);
      else if (scheme.in === 'cookie') cookies.set(scheme.name, credentials[index]);
    });
    return;
  }
  throw new Error('authentication arguments do not satisfy any OpenAPI security requirement');
}
async function invoke(binding: Binding, args: Record<string, unknown>, traceparent?: string) {
  let path = binding.path;
  const query = new URLSearchParams(), cookies = new URLSearchParams();
  const headers: Record<string, string> = { accept: 'application/json' };
  if (process.env.REST_BEARER_TOKEN) headers.authorization = 'Bearer ' + process.env.REST_BEARER_TOKEN;
  for (const parameter of binding.parameters) {
    const value = lookup(args, parameter.argument);
    if (value === undefined || value === null) {
      if (parameter.required) throw new Error('missing argument: ' + parameter.argument.join('.'));
      continue;
    }
    if (parameter.in === 'path') path = path.split('{' + parameter.name + '}').join(simple(value, parameter.explode, true));
    else if (parameter.in === 'query') addParameter(query, parameter, value);
    else if (parameter.in === 'header') headers[parameter.name.toLowerCase()] = simple(value, parameter.explode);
    else if (parameter.in === 'cookie') cookies.append(parameter.name, scalar(value));
  }
  security(binding, args, headers, query, cookies);
  const target = new URL((overrideBaseURL || binding.baseURL).replace(/\/+$/, '') + path);
  if (!['http:', 'https:'].includes(target.protocol) || target.hash) throw new Error('invalid REST URL');
  target.search = query.toString();
  if ([...cookies].length) headers.cookie = [...cookies].sort(([a], [b]) => a.localeCompare(b)).map(([key, value]) => key + '=' + new URLSearchParams({ value }).toString().slice(6)).join('; ');
  let body: string | undefined;
  if (binding.body && args.body !== undefined && args.body !== null) {
    headers['content-type'] = binding.contentType;
    if (binding.contentType === 'application/x-www-form-urlencoded') {
      if (!object(args.body)) throw new Error('form body must be an object');
      const form = new URLSearchParams();
      for (const key of Object.keys(args.body).sort()) addParameter(form, { name: key, style: 'form', explode: true } as Parameter, args.body[key]);
      body = form.toString();
    } else if (binding.contentType === 'text/plain') {
      if (typeof args.body !== 'string') throw new Error('text body must be a string');
      body = args.body;
    } else body = JSON.stringify(args.body);
  } else if (binding.bodyRequired) throw new Error('missing argument: body');
  if (traceparent) headers.traceparent = traceparent;
  const response = await fetch(target, {
    method: binding.method,
    headers,
    body,
    signal: AbortSignal.timeout(10000),
  });
  const text = await response.text();
  if (Buffer.byteLength(text, 'utf8') > 4 * 1024 * 1024) throw new Error('REST response exceeds 4 MiB');
  return { content: [{ type: 'text', text }], isError: response.status >= 400 };
}

async function handle(request: IncomingMessage, response: ServerResponse): Promise<void> {
  const pathname = new URL(request.url ?? '/', 'http://localhost').pathname;
  if (pathname === '/health') { json(response, 200, { status: 'ok' }); return; }
  if (pathname !== '/mcp') { response.writeHead(404); response.end(); return; }
  if (request.headers.origin) {
    let allowed = false;
    try {
      const origin = new URL(request.headers.origin);
      allowed = ['http:', 'https:'].includes(origin.protocol) && origin.host === request.headers.host;
    } catch { /* invalid Origin */ }
    if (!allowed) { json(response, 403, { error: 'origin not allowed' }); return; }
  }
  if (process.env.MCP_BEARER_TOKEN && request.headers.authorization !== 'Bearer ' + process.env.MCP_BEARER_TOKEN) {
    json(response, 401, { error: 'unauthenticated' }); return;
  }
  if (request.method !== 'POST') { response.writeHead(405, { Allow: 'POST' }); response.end(); return; }
  if ((request.headers['content-type'] ?? '').split(';')[0] !== 'application/json') {
    json(response, 415, { error: 'use application/json' }); return;
  }
  let message: unknown;
  try { message = await readJSON(request); }
  catch { rpcError(response, 400, null, -32700, 'invalid JSON'); return; }
  if (!object(message) || message.jsonrpc !== '2.0' || typeof message.method !== 'string' || !message.method) {
    rpcError(response, 400, null, -32600, 'invalid request'); return;
  }
  if (!('id' in message)) { response.writeHead(202); response.end(); return; }
  const id = message.id;
  let result: unknown;
  switch (message.method) {
    case 'initialize':
      result = { protocolVersion, capabilities: { tools: { listChanged: false } }, serverInfo: { name: metadata.name, version: metadata.version } };
      break;
    case 'ping': result = {}; break;
    case 'tools/list': result = { tools: metadata.bindings.map(binding => binding.tool) }; break;
    case 'tools/call': {
      if (!object(message.params) || typeof message.params.name !== 'string' ||
          (message.params.arguments !== undefined && !object(message.params.arguments))) {
        rpcError(response, 200, id, -32602, 'invalid parameters'); return;
      }
      const binding = tools.get(message.params.name);
      if (!binding) { rpcError(response, 200, id, -32602, 'unknown tool'); return; }
      const args = (message.params.arguments ?? {}) as Record<string, unknown>;
      for (const key of binding.tool.inputSchema.required ?? []) {
        if (args[key] === undefined || args[key] === null) { rpcError(response, 200, id, -32602, 'missing argument: ' + key); return; }
      }
      try {
        const traceparent = request.headers.traceparent;
        result = await invoke(binding, args, Array.isArray(traceparent) ? traceparent[0] : traceparent);
      } catch (error) {
        result = { content: [{ type: 'text', text: error instanceof Error ? error.message : String(error) }], isError: true };
      }
      break;
    }
    default: rpcError(response, 200, id, -32601, 'method not found'); return;
  }
  json(response, 200, { jsonrpc: '2.0', id, result });
}

const port = Number(process.env.PORT ?? '8081');
if (!Number.isInteger(port) || port < 0 || port > 65535) throw new Error('invalid PORT');
const server = createServer((request, response) => {
  void handle(request, response).catch(() => {
    if (!response.headersSent) rpcError(response, 500, null, -32603, 'internal error');
    else response.destroy();
  });
});
server.requestTimeout = 15000;
server.headersTimeout = 10000;
server.on('error', error => { console.error(error.message); process.exit(1); });
server.listen(port, process.env.HOST ?? '127.0.0.1', () => {
  const address = server.address();
  if (address && typeof address !== 'string') console.log('MCP_URL=http://127.0.0.1:' + address.port + '/mcp');
});
