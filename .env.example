# ===== 部署编排 =====
COMPOSE_PROJECT_NAME=mcp-marketplace

# ===== PostgreSQL =====
POSTGRES_USER=mcp
POSTGRES_PASSWORD=mcp-secret
POSTGRES_DB=mcp_market
DATABASE_URL=postgres://mcp:mcp-secret@postgres:5432/mcp_market?sslmode=disable

# ===== Redis =====
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== 网关 =====
HTTP_PORT=8080
GIN_MODE=release
JWT_SECRET=change-me-in-prod-please-32-chars!
JWT_TTL_HOURS=24

# 限流：每个请求方每秒允许请求数；熔断：失败比例与窗口
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
CIRCUIT_FAIL_RATIO=0.5
CIRCUIT_MIN_SAMPLES=10
CIRCUIT_INTERVAL=10s
CIRCUIT_WINDOW=30s

# 成本计量：默认每 1000 tokens 折算的价格（演示用）
COST_PER_1K_TOKENS=0.002

# ===== 可观测 =====
OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# 种子管理员（首次启动自动创建）
ADMIN_USER=admin
ADMIN_PASS=admin123

# ===== mock 服务地址（网关内部访问）=====
LEGACY_API_URL=http://legacy-api:9002
MOCK_MCP_URL=http://mock-mcp:9003
MOCK_FILE_URL=http://mock-file:9004
MOCK_DB_URL=http://mock-db:9005

# 启动时自动注册 mock 服务并自动包装 OpenAPI 工具
SEED_ON_STARTUP=true
# 可选：从该地址拉取 OpenAPI 文档（默认取 LEGACY_API_URL/openapi.json）
OPENAPI_SPEC_URL=

# ===== 前端 =====
VITE_API_BASE=http://localhost:8080
